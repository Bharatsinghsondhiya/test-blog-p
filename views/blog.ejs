<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>BlogPage</title>
</head>

<body>
    <%- include("./partials/css") %>
        <%- include("./partials/nav") %>


            <div class="container mt-5">
                <div class="blog-content-wrapper" style="background: var(--glass-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); padding: 3rem; border-radius: 20px; box-shadow: var(--glass-shadow); border: 1px solid var(--glass-border);">
                    <h2 class="fw-bold mb-3" style="color: var(--text-main);">
                        <%= blog.tittle || blog.title || 'Untitled' %>
                    </h2>
                    <div class="meta mb-4 pb-3 border-bottom" style="font-size: 0.9rem; color: var(--accent-color); border-color: rgba(255,255,255,0.1) !important;">
                        <span><small class="fw-semibold">
                                BY <%= blog.CreatedBy && blog.CreatedBy.fullName ? blog.CreatedBy.fullName : "Anonymous" %>
                            </small></span>
                        <span class="mx-2" style="color: var(--text-muted);">•</span>
                        <span><small style="color: var(--text-muted);">
                                <%= blog.createdAt ? new Date(blog.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : '' %>
                            </small></span>
                    </div>
                    
                    <img src="<%= blog.coverImageURL || '/images/placeholder-600x400.png' %>" class="img-fluid rounded-4 shadow-sm mb-5 w-100" style="max-height: 500px; object-fit: cover;" alt="cover" onerror="this.onerror=null;this.src='/images/placeholder-600x400.png';" />
                    
                    <div class="blog-body" style="font-size: 1.1rem; line-height: 1.8; color: var(--text-muted);">
                        <%= blog.body || 'No preview available.' %>
                    </div>
                </div>

                <div class="comments-section mt-5 mb-5 p-4" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(16px); border-radius: 16px; border: 1px solid var(--glass-border); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <h3 class="mb-4 fw-bold" style="color: var(--text-main);">Comments</h3>
                    
                    <% if (locals.user) { %>
                    <form action="/blog/comment/<%=blog._id %>" method="post" class="mb-4" style="all: unset; display: block;"> 
                        <div class="d-flex gap-2">
                            <input 
                            type="text" 
                            name="content"
                            class="form-control"
                            placeholder="Write your comment..."
                            />
                            <button class="btn btn-purple px-4" style="border-radius: 12px; margin: 0;" type="submit">Post</button>
                        </div>
                    </form>
                    <% } else { %>
                        <div class="alert text-center" style="border-radius: 12px; border: 1px dashed rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);">
                            <a href="/user/signin" class="text-decoration-none fw-semibold" style="color: var(--accent-color);">Log in</a> to leave a comment.
                        </div>
                    <% } %>
                    
                    <div class="mt-4">
                        <% if (comments && comments.length > 0) { %>
                            <% comments.forEach(comment => { %>
                                <div class="p-3 mb-3" style="background: rgba(255,255,255,0.05); border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-semibold" style="font-size: 0.95rem; color: var(--text-main);">
                                            <%= comment.CreatedBy && comment.CreatedBy.fullName ? comment.CreatedBy.fullName : 'Anonymous' %>
                                        </div>
                                        <div style="color: var(--text-muted); font-size: 0.8rem;">
                                            <%= new Date(comment.createdAt).toLocaleDateString() %>
                                        </div>
                                    </div>
                                    <div style="color: var(--text-muted); font-size: 0.95rem;">
                                        <%= comment.content %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="mt-3 mb-0" style="font-size: 0.95rem; color: rgba(255,255,255,0.5);">No comments yet. Be the first to share your thoughts!</p>
                        <% } %>
                    </div>
                </div>
            </div>

                <%- include("./partials/script") %>
</body>

<html>

</html>